# Copy to .env  (cp .env.example .env)  — never commit .env

# ---- Core ----
DATABASE_URL=postgres://app:app@127.0.0.1:5432/affiliate_video
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_DIR=./storage
WEB_ORIGIN=http://localhost:5173

# ---- Credits (SaaS) ----
SIGNUP_FREE_CREDITS=30
JOB_CREDIT_COST=10
# video from the user's own uploaded clip (e.g. made in Google Flow): voiceover + captions only
UPLOAD_CREDIT_COST=2
# AI scene images (Gemini image, ~US$0.07 each): credits per image, then per video made from them
SCENE_CREDIT_COST=1
SCENES_VIDEO_CREDIT_COST=2
# AI script writing is free for users, so cap it per user per hour
SCRIPT_GEN_PER_HOUR=20
# "Paste a product link" imports (photo downloads from the shop CDNs) per user per hour
LINK_IMPORT_PER_HOUR=60

# ---- LLM: AI scripts + video prompts (any OpenAI-compatible API) ----
# Leave LLM_API_KEY empty to use GEMINI_API_KEY (below) with Gemini — one key for everything.
# No LLM_API_KEY and no GEMINI_API_KEY → built-in sample scripts (development).
# For another provider set all three, e.g. https://api.openai.com/v1 + sk-… + gpt-4.1-mini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# tried in order when the main model is busy or hangs (comma separated)
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# ---- Product clip ----
# auto     = Seedance when SEEDANCE_API_KEY is set, otherwise a free zoom/pan video from the product photos
# photos   = always the free photo video (no AI cost)
# seedance = always Seedance
# gemini   = Gemini Omni video (needs GEMINI_API_KEY below; never chosen by auto)
# sample   = samples/sample-product-clip.mp4 (pipeline testing only)
CLIP_MODE=auto

# ---- Seedance (BytePlus ModelArk) ----
# Leave SEEDANCE_API_KEY empty to make videos from the product photos instead (free).
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_API_KEY=
# Copy the exact Seedance 2.5 model ID from the ModelArk model list
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=10

# ---- Gemini video (Google AI Studio key) — used when CLIP_MODE=gemini ----
# Gemini Omni Flash, paid tier only (~US$0.07/s at 720p — check aistudio.google.com/docs/pricing)
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
# whole seconds 3–15; Burmese voiceover runs longer, so 12–15 gives the script more room
GEMINI_VIDEO_DURATION=10
GEMINI_VIDEO_RESOLUTION=720p
# AI scene images: Nano Banana 2 (gemini-3.1-flash-image) at 1K ≈ US$0.067 per image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K

# ---- Voiceover ----
# azure  = Azure AI Speech (official, use in production)
# edge   = edge-tts CLI (unofficial, prototype only)
# gemini = Gemini TTS (uses GEMINI_API_KEY) — most natural, creator-style delivery (~US$0.003 per video)
# voxcpm = local VoxCPM2 (free, runs on your Mac, can clone YOUR voice) — start tools/voxcpm-server.py first
# none   = no voiceover (product sound + text only)
TTS_PROVIDER=none
# per-language override, e.g. Thai with Gemini and Burmese with your own cloned voice:
# TTS_PROVIDER_TH=gemini
# TTS_PROVIDER_MY=voxcpm
# VOXCPM_URL=http://127.0.0.1:8808
# 1.15 = 15% faster speech (pitch kept); per language: VOXCPM_SPEED_TH / VOXCPM_SPEED_MY
# VOXCPM_SPEED=1.15
# fixed AI voice: `node tools/voxcpm-make-voice.mjs`, then start the server with the VOXCPM_REF_* lines it prints
# VOXCPM_TIMEOUT_MS=300000
# Gemini voice (Leda, Aoede, Puck, Achird, Kore …) — one for both languages, or per language
# GEMINI_TTS_VOICE=Leda
# GEMINI_TTS_VOICE_TH=Leda
# GEMINI_TTS_VOICE_MY=Leda
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# edge: install with `brew install pipx && pipx install edge-tts`; set the full path if ~/.local/bin is not on PATH
# EDGE_TTS_BIN=/Users/<you>/.local/bin/edge-tts
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# ---- Shopee Affiliate Open API (Thailand) ----
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.co.th/graphql
SHOPEE_APP_ID=
SHOPEE_SECRET=
