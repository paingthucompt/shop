# Copy to .env  (cp .env.example .env)  — never commit .env

# ---- Core ----
DATABASE_URL=postgres://app:app@127.0.0.1:5432/affiliate_video
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_DIR=./storage
WEB_ORIGIN=http://localhost:5173

# ---- Credits (SaaS) ----
SIGNUP_FREE_CREDITS=30
JOB_CREDIT_COST=10
# AI script writing is free for users, so cap it per user per hour
SCRIPT_GEN_PER_HOUR=20

# ---- LLM (OpenAI-compatible: OpenAI / OpenRouter / Gemini OpenAI endpoint / etc.) ----
# Leave LLM_API_KEY empty to use built-in mock scripts during development.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# ---- Product clip ----
# auto     = Seedance when SEEDANCE_API_KEY is set, otherwise a free zoom/pan video from the product photos
# photos   = always the free photo video (no AI cost)
# seedance = always Seedance
# sample   = samples/sample-product-clip.mp4 (pipeline testing only)
CLIP_MODE=auto

# ---- Seedance (BytePlus ModelArk) ----
# Leave SEEDANCE_API_KEY empty to make videos from the product photos instead (free).
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_API_KEY=
# Copy the exact Seedance 2.5 model ID from the ModelArk model list
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_RESOLUTION=720p
SEEDANCE_DURATION=10

# ---- Voiceover ----
# azure  = Azure AI Speech (official, use in production)
# edge   = edge-tts CLI (unofficial, prototype only)
# none   = no voiceover (product sound + text only)
TTS_PROVIDER=none
# edge: install with `brew install pipx && pipx install edge-tts`; set the full path if ~/.local/bin is not on PATH
# EDGE_TTS_BIN=/Users/<you>/.local/bin/edge-tts
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# ---- Shopee Affiliate Open API (Thailand) ----
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.co.th/graphql
SHOPEE_APP_ID=
SHOPEE_SECRET=
